# --- AI Guide (color analysis + recommendations) ---
# Google Gemini API key — used for vision analysis + LLM recommendations
GEMINI_API_KEY=

# Gemini model (default: gemini-2.5-flash). Use gemini-2.5-pro for higher quality.
GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs Conversational AI (voice guide) ---
# Public agent ID (safe to expose to the browser — it's bound to the agent's allowed origins).
ELEVENLABS_AGENT_ID=

# Set to "false" to disable user mic input — AI will speak at each step but users cannot talk back.
# Set to "true" (default) to allow full two-way conversation.
ELEVENLABS_INTERACTIVE=true

# --- Manual Try-On (existing n8n outfit-swap webhook) ---
# Override the webhook from the browser by setting this; falls back to config.js default.
N8N_WEBHOOK_URL=

# --- Server ---
PORT=3000
